import torch
from diffusers import DiffusionPipeline
from diffusers.utils import load_image

class LocalImageGen:
    def __init__(self, model_name="black-forest-labs/FLUX.2-klein-base-9B", device=None):
        self.device = device or ("cuda" if torch.cuda.is_available() else "cpu")
        self.pipe = DiffusionPipeline.from_pretrained(
            model_name, dtype=torch.bfloat16, device_map=self.device
        )

    def generate(self, prompt, input_image_url, out_path):
        input_image = load_image(input_image_url)
        image = self.pipe(prompt=prompt, image=input_image).images[0]
        image.save(out_path)
        return out_path

if __name__ == "__main__":
    import sys
    prompt = sys.argv[1] if len(sys.argv) > 1 else "Turn this cat into a dog"
    input_image_url = (
        sys.argv[2]
        if len(sys.argv) > 2
        else "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/cat.png"
    )
    out = sys.argv[3] if len(sys.argv) > 3 else "output.png"
    gen = LocalImageGen()
    gen.generate(prompt, input_image_url, out)
    print(f"Image saved: {out}")